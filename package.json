{
	"name": "sk-prisma-quickstart",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev": "pnpm prisma generate && pnpm prisma migrate deploy && pnpm seed && vite dev",
		"seed": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/seed/seed.js",
		"build": "pnpm prisma generate && pnpm generate-sw && vite build",
		"serve": "pnpm prisma migrate deploy && ./scripts/pwa/sw-domain.sh && pnpm seed && node -r dotenv/config build/index.js",
		"generate-sw": "node src/lib/utils/pwa/generate-sw.js",
		"i18n:generate": "node scripts/i18n/generate-locales.mjs",
		"compatibility:manifest": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/parse/compatibility/cli.js --bootstrap-manifest",
		"compatibility:scrape": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/parse/compatibility/cli.js",
		"compatibility:track": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/parse/compatibility/cli.js --add-url --refresh-fixtures --status all",
		"compatibility:diff": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/parse/compatibility/cli.js --diff",
		"dev:install": "pnpm i && pnpm prisma generate",
		"dev:setup": "pnpm generate-sw && pnpm prisma generate && pnpm prisma migrate deploy && ./scripts/pwa/sw-domain.sh",
		"test": "vitest",
		"test:watch": "pnpm test -- --watch",
		"coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"docs:jsdocs": "python docs/scripts/generate_jsdocs.py",
		"docs:screen": "python docs/scripts/screenshots.py",
		"docs:build": "pnpm docs:jsdocs && pnpm docs:screen",
		"start": "pnpm build && pnpm serve"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@humanspeak/svelte-virtual-list": "^0.3.13",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^4.2.3",
		"chai": "^6.3.0",
		"daisyui": "^5.7.47",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"js-beautify": "^1.15.4",
		"jsdom": "28.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prisma": "^7.10.0",
		"recipe-ingredient-parser-v3": "^1.5.0",
		"sass": "^1.105.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"vite": "^5.4.21",
		"vitest": "^3.2.7"
	},
	"pnpm": {
		"overrides": {
			"form-data": "^4.0.4",
			"glob": "^10.5.0",
			"hono": "^4.11.7",
			"fast-xml-parser": "^5.3.4",
			"esbuild": "^0.25.0",
			"lodash": "^4.17.23",
			"js-yaml": "^4.1.1",
			"cookie": "^0.7.0",
			"brace-expansion": "^2.0.2",
			"diff": "^4.0.4",
			"@eslint/plugin-kit": "^0.3.4"
		}
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@capacitor/android": "^8.5.3",
		"@capacitor/app": "^8.1.2",
		"@capacitor/cli": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"@langchain/anthropic": "^1.5.12",
		"@langchain/core": "^1.2.17",
		"@langchain/google-genai": "^2.3.2",
		"@langchain/ollama": "^1.3.0",
		"@langchain/openai": "^1.6.2",
		"@libsql/client": "^0.15.15",
		"@lucia-auth/adapter-prisma": "^3.0.2",
		"@lucia-auth/oauth": "^3.5.3",
		"@prisma/adapter-libsql": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"archiver": "^6.0.2",
		"axios": "^1.20.0",
		"better-sqlite3": "^12.11.1",
		"csv-parser": "^3.2.1",
		"dompurify": "^3.4.16",
		"dotenv": "^16.6.1",
		"file-type": "^20.5.0",
		"franc": "^6.2.0",
		"fuse.js": "^6.6.2",
		"he": "^1.2.0",
		"humanize-duration": "^3.35.0",
		"langchain": "^1.5.15",
		"lucia": "^2.7.7",
		"marked": "^9.1.6",
		"node-html-parser": "^6.1.13",
		"openai": "^4.104.0",
		"openid-client": "^6.8.8",
		"parse-iso-duration": "^1.1.0",
		"sanitize-html": "^2.18.0",
		"sharp": "^0.35.5",
		"svelte-dnd-action": "^0.9.80",
		"unzipper": "^0.12.5",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1",
		"youtube-transcript": "^1.3.1",
		"zod": "^3.25.76"
	}
}
