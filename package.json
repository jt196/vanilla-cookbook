{
	"name": "sk-prisma-quickstart",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "pnpm prisma generate && pnpm prisma migrate deploy && pnpm seed && vite dev",
		"seed": "node --loader ./scripts/alias-loader.mjs ./src/lib/utils/seed/seed.js",
		"build": "pnpm prisma generate && pnpm generate-sw && vite build",
		"serve": "pnpm prisma migrate deploy && ./scripts/pwa/sw-domain.sh && pnpm seed && node -r dotenv/config build/index.js",
		"generate-sw": "node src/lib/utils/pwa/generate-sw.js",
		"dev:install": "pnpm i && pnpm prisma generate",
		"dev:setup": "pnpm generate-sw && pnpm prisma generate && pnpm prisma migrate deploy && ./scripts/pwa/sw-domain.sh",
		"test": "vitest",
		"test:watch": "pnpm test -- --watch",
		"coverage": "vitest run --coverage",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"docs:jsdocs": "python docs/scripts/generate_jsdocs.py",
		"docs:screen": "python docs/scripts/screenshots.py",
		"docs:build": "pnpm docs:jsdocs && pnpm docs:screen",
		"start": "pnpm build && pnpm serve"
	},
	"devDependencies": {
		"@event-calendar/core": "^3.10.0",
		"@event-calendar/day-grid": "^3.10.0",
		"@event-calendar/interaction": "^3.10.0",
		"@event-calendar/list": "^3.10.0",
		"@event-calendar/time-grid": "^3.10.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^4.0.3",
		"@typescript-eslint/eslint-plugin": "^8.26.0",
		"@typescript-eslint/parser": "^8.26.0",
		"chai": "^6.2.2",
		"daisyui": "^5.5.14",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.2",
		"eslint-plugin-jsdoc": "^50.6.3",
		"eslint-plugin-svelte": "^3.0.3",
		"global-jsdom": "28.0.0",
		"js-beautify": "^1.15.4",
		"jsdom": "28.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prisma": "^7.0.0",
		"recipe-ingredient-parser-v3": "^1.3.0",
		"rome": "^12.1.3",
		"sass": "^1.85.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.4",
		"svelte-preprocess": "^6.0.3",
		"@humanspeak/svelte-virtual-list": "^0.3.10",
		"tailwindcss": "^4.1.18",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"vite": "^5.4.21",
		"vitest": "^3.0.7"
	},
	"pnpm": {
		"overrides": {
			"eslint-plugin-svelte3": "npm:eslint-plugin-svelte@3.0.3",
			"form-data": "^4.0.4",
			"glob": "^10.5.0",
			"hono": "^4.11.7",
			"fast-xml-parser": "^5.3.4",
			"esbuild": "^0.25.0",
			"lodash": "^4.17.23",
			"js-yaml": "^4.1.1",
			"cookie": "^0.7.0",
			"brace-expansion": "^2.0.2",
			"diff": "^4.0.4",
			"@eslint/plugin-kit": "^0.3.4"
		}
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.985.0",
		"@langchain/anthropic": "^1.3.17",
		"@langchain/core": "^1.1.24",
		"@langchain/google-genai": "^2.1.18",
		"@langchain/ollama": "^1.2.2",
		"@langchain/openai": "^1.2.7",
		"@libsql/client": "^0.15.15",
		"@lucia-auth/adapter-prisma": "^3.0.2",
		"@lucia-auth/oauth": "^3.5.3",
		"@prisma/adapter-libsql": "^7.2.0",
		"@prisma/client": "^7.0.0",
		"archiver": "^6.0.1",
		"axios": "^1.13.5",
		"better-sqlite3": "^12.5.0",
		"csv-parser": "^3.0.0",
		"dompurify": "^3.0.6",
		"dotenv": "^16.4.7",
		"file-type": "^20.4.0",
		"franc": "^6.2.0",
		"fuse.js": "^6.6.2",
		"he": "^1.2.0",
		"humanize-duration": "^3.29.0",
		"langchain": "^1.2.24",
		"lucia": "^2.7.6",
		"marked": "^9.0.0",
		"node-html-parser": "^6.1.10",
		"openai": "^4.88.0",
		"openid-client": "^6.8.1",
		"parse-iso-duration": "^1.1.0",
		"sanitize-html": "^2.14.0",
		"sharp": "^0.33.5",
		"svelte-dnd-action": "^0.9.24",
		"unzipper": "^0.12.3",
		"workbox-build": "^7.0.0",
		"workbox-window": "^7.0.0",
		"zod": "^3.25.76"
	}
}
