# =============================================================================
# Vanilla Cookbook Environment Configuration
# =============================================================================
# Copy this file to .env and configure as needed.
# Only ORIGIN is required - everything else has sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# The full URL where your app is hosted (critical for auth cookies and CORS)
# Examples:
#   Local dev:  http://localhost:5173
#   Docker:     http://localhost:3000
#   Production: https://recipes.example.com
ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL - General Settings
# -----------------------------------------------------------------------------
# These all have defaults - only uncomment if you need to override

# Site name shown in browser tab and headers (default: "Vanilla Cookbook")
# VITE_SITE_NAME="Vanilla Cookbook"

# Maximum request body size in bytes (applies to photo uploads and recipe imports)
# Docker: defaults to 5MB in Dockerfile
# Non-Docker: SvelteKit default is 512kb, so we set 5MB here
# BODY_SIZE_LIMIT=5242880

# -----------------------------------------------------------------------------
# OPTIONAL - Authentication (OAuth/OIDC)
# -----------------------------------------------------------------------------
# Enable social login by adding credentials for any provider you want to use.
# Leave blank to disable that provider.

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Generic OIDC Provider (Authentik, Keycloak, Authelia, etc.)
# OIDC_ISSUER_URL=https://auth.example.com/application/o/vanilla/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Custom SSO              # Button label (default: "OIDC")
# OIDC_EMAIL_CLAIM=email            # Claim for email (default: "email")
# OIDC_NAME_CLAIM=preferred_username # Claim for username (default: "preferred_username")
# OIDC_SCOPES=openid email profile  # Scopes to request (default: "openid email profile")

# -----------------------------------------------------------------------------
# OPTIONAL - AI/LLM Features
# -----------------------------------------------------------------------------
# Add API keys for the providers you want to use for recipe parsing assistance.
# Provider and model selection is configured in the Site Settings admin panel.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Ollama (local models) - only set if not using default localhost
# OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# OPTIONAL - Security Tuning
# -----------------------------------------------------------------------------
# All have sensible defaults - only set if you need to customize

# Rate limiting (defaults: 60000ms window, 10 attempts per IP, 5 per user)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_PER_IP=10
# RATE_LIMIT_LOGIN_PER_ID=5

# Password requirements (defaults: 8 chars, require upper/lower/digit/special)
# PASSWORD_MIN_LENGTH=8
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_DIGIT=true
# PASSWORD_REQUIRE_SPECIAL=true

# -----------------------------------------------------------------------------
# OPTIONAL - Docker Backups
# -----------------------------------------------------------------------------
# Only applies when running in Docker with the backup container

# Cron schedule for automated backups (default: Sundays at 3am)
# Format: "minute hour day month weekday"
# BACKUP_CRON_SCHEDULE=0 3 * * 0

# Number of scheduled backups to keep (default: 6)
# BACKUP_RETENTION_COUNT=6
