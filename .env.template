# URL

# Local Dev
# ORIGIN=http://localhost:5173
# Docker
ORIGIN=http://localhost:3000

# Frontend Variables
VITE_SITE_NAME="Vanilla Cookbook"

# Maximum file upload size in bytes
BODY_SIZE_LIMIT=5242880

# Absolute File path to project folder
# **You probably don't need to worry about this unless you're going to be importing via the Paprika API**
VITE_APP_ROOT_PATH=/Your/Full/Path/To/Production/Folder/

# Open AI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_ENABLED=true
LLM_PROVIDER=openai
# Optional overrides per stream
LLM_TEXT_PROVIDER=
LLM_IMAGE_PROVIDER=
LLM_TEXT_MODEL=gpt-3.5-turbo
LLM_IMAGE_MODEL=gpt-4o

# Generic API key (fallback) or provider-specific keys
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# For Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_ID=5

# Password Requirements
# All have sensible defaults - only set if you want to override
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Database Backups (Docker only)
# Cron schedule for automated backups (default: Sundays at 3am)
# Format: "minute hour day month weekday"
# Examples:
#   0 3 * * 0    = Every Sunday at 3am (default)
#   0 2 * * *    = Every day at 2am
#   0 4 * * 1    = Every Monday at 4am
#   0 3 1 * *    = 1st of every month at 3am
BACKUP_CRON_SCHEDULE=0 3 * * 0

# Number of scheduled backups to keep (default: 6 = 6 weeks for weekly backups)
BACKUP_RETENTION_COUNT=6
